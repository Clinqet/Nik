{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClinketProvider",
  "type": "object",
  "required": ["id", "businessName", "geo", "categories", "scrapedAt", "sources"],
  "properties": {
    "id": { "type": "string", "description": "Stable slug: city-area-businessname" },
    "businessName": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "businessImageUrl": { "type": ["string", "null"] },
    "employeeCount": { "type": ["integer", "string", "null"] },
    "yearsInBusiness": { "type": ["number", "string", "null"] },
    "owner": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] }
      }
    },
    "businessEmail": { "type": ["string", "null"] },
    "businessPhone": { "type": ["string", "null"] },
    "social": {
      "type": "object",
      "properties": {
        "facebook": { "type": ["string", "null"] },
        "instagram": { "type": ["string", "null"] },
        "youtube": { "type": ["string", "null"] },
        "tiktok": { "type": ["string", "null"] },
        "linkedin": { "type": ["string", "null"] },
        "twitter": { "type": ["string", "null"] },
        "website": { "type": ["string", "null"] },
        "other": { "type": "array", "items": { "type": "string" } }
      }
    },
    "address": {
      "type": "object",
      "properties": {
        "street": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "area": { "type": ["string", "null"] },
        "province": { "type": "string", "default": "ON" },
        "postalCode": { "type": ["string", "null"] },
        "country": { "type": "string", "default": "Canada" },
        "formatted": { "type": ["string", "null"] }
      }
    },
    "serviceAreas": { "type": "array", "items": { "type": "string" } },
    "geo": {
      "type": "object",
      "required": ["city", "area"],
      "properties": {
        "city": { "type": "string" },
        "area": { "type": "string" },
        "region": { "type": "string", "default": "Hamilton" }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": { "type": "string" },
          "subcategory": { "type": ["string", "null"] }
        },
        "required": ["category"]
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "imageUrl": { "type": ["string", "null"] },
          "price": {
            "type": "object",
            "properties": {
              "type": { "type": ["string", "null"], "description": "fixed | hourly | starting_from | range | quote" },
              "amount": { "type": ["number", "null"] },
              "min": { "type": ["number", "null"] },
              "max": { "type": ["number", "null"] },
              "currency": { "type": "string", "default": "CAD" },
              "notes": { "type": ["string", "null"] }
            }
          },
          "travelFee": { "type": ["string", "number", "null"] },
          "ongoingFee": { "type": ["string", "number", "null"] }
        },
        "required": ["name"]
      }
    },
    "availability": {
      "type": "object",
      "properties": {
        "timezone": { "type": "string", "default": "America/Toronto" },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": { "type": "string" },
              "open": { "type": ["string", "null"] },
              "close": { "type": ["string", "null"] },
              "closed": { "type": "boolean" }
            }
          }
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "validUntil": { "type": ["string", "null"] }
        }
      }
    },
    "portfolio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] },
          "imageUrl": { "type": ["string", "null"] },
          "completedAt": { "type": ["string", "null"] }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "type": { "type": "string", "description": "google | website | kijiji | facebook | yelp | directory | other" },
          "scrapedAt": { "type": "string" }
        },
        "required": ["url", "type"]
      }
    },
    "dataQuality": {
      "type": "object",
      "properties": {
        "phoneValidated": { "type": ["boolean", "null"] },
        "emailValidated": { "type": ["boolean", "null"] },
        "completenessScore": { "type": ["number", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "scrapedAt": { "type": "string", "format": "date-time" }
  }
}
